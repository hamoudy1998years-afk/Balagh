{
  "expo": {
    "name": "Bushrann",
    "slug": "Balagh",
    "scheme": "bushrann",
    "version": "1.7.20",
    "privacyPolicyUrl": "https://sites.google.com/view/bushrann/privacy-policy ",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#1a2e44"
    },
    "ios": {
      "supportsTablet": false,
      "facebookAppId": "1749165319852187",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Allow Bushrann to access your photos to update your profile picture.",
        "NSPhotoLibraryAddUsageDescription": "Allow Bushrann to save videos to your photo library.",
        "NSCameraUsageDescription": "Allow Bushrann to access your camera to take a profile photo and record videos.",
        "NSMicrophoneUsageDescription": "Allow Bushrann to access your microphone for live streaming and video recording.",
        "NSFaceIDUsageDescription": "Allow Bushrann to use Face ID for secure and quick sign in.",
        "NSLocationWhenInUseUsageDescription": "Bushrann uses your precise location to calculate accurate prayer times, Qibla direction, and Adhan notifications."
      }
    },
    "android": {
      "versionCode": 42,
      "minSdkVersion": 24,
      "largeHeap": true,
      "navigationBar": {
        "backgroundColor": "#000000",
        "barStyle": "light-content"
      },
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a2e44"
      },
      "package": "com.bushrann.app",
      "googleServicesFile": "./google-services.json",
      "facebookAppId": "1749165319852187",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.VIBRATE",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidSplashIcon.js",
      "./plugins/withForceLightStatusBar.js",
      [
        "react-native-edge-to-edge",
        {
          "android": {
            "parentTheme": "Default.NoActionBar",
            "enforceEdgeToEdge": true
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "kotlinCompilerArgs": [
              "-opt-in=kotlin.RequiresOptIn"
            ]
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#B76E79",
          "sounds": ["./assets/audio/adhan_alert.wav", "./assets/audio/adhan_ios_makkah.wav", "./assets/audio/adhan_ios_madinah.wav", "./assets/audio/adhan_ios_aqsa.wav", "./assets/audio/adhan_ios_fajr.wav"]
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Bushrann to use Face ID for sign in"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Bushrann to access your photos to update your profile picture.",
          "cameraPermission": "Allow Bushrann to access your camera to take a profile photo."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Allow Bushrann to access your photos.",
          "savePhotosPermission": "Allow Bushrann to save videos to your photo library.",
          "isAccessMediaLocationEnabled": true
        }
      ],
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Bushrann uses your precise location to calculate accurate prayer times, Qibla direction, and Adhan notifications."
        }
      ],
      "react-native-video",
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "5804d13c-1244-4972-8b7a-083f99fbb885"
      }
    },
    "termsOfServiceUrl": "https://sites.google.com/view/bushrann/terms "
  }
}
